# Copy to ".env" and fill in. NEVER commit the real .env file.
# Special characters in DB_PASSWORD (@ # / : % etc.) are fine - write the password exactly as-is, no URL-encoding.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pga_user
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=project_guide_allocation

# At least 32 random characters. Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
JWT_EXPIRE_MINUTES=480

# Comma-separated list of allowed browser origins (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173

# Optional e-mail delivery (password-reset links). Leave SMTP_HOST empty to disable e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Allocation optimiser (OR-Tools CP-SAT). Time budget for one allocation run, shared by all optimisation stages.
ALLOCATION_SOLVER_TIME_LIMIT_SECONDS=30
# Keep at 1 for deterministic results.
ALLOCATION_SOLVER_WORKERS=1
